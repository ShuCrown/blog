---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { getCollection } from 'astro:content';

const query = Astro.url.searchParams.get('q') || '';
const allPosts = await getCollection('posts');

const results = query
  ? allPosts.filter(post =>
      post.data.title.toLowerCase().includes(query.toLowerCase()) ||
      post.data.description?.toLowerCase().includes(query.toLowerCase())
    )
  : [];
---

<Layout title="搜索" description="搜索文章">
  <Nav />
  <div class="max-w-2xl mx-auto px-3 py-12">
    <form action="/search" method="get" class="relative">
      <input
        type="text"
        name="q"
        value={query}
        placeholder="搜索文章..."
        class="w-full px-4 py-3 text-lg border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-transparent"
        autofocus
      />
      <button
        type="submit"
        class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-pink-500"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
    </form>

    {query && (
      <div class="mt-8">
        <p class="text-gray-500 mb-4">
          {results.length === 0 ? '未找到' : `找到 ${results.length} 个结果`}
        </p>
        <ul class="space-y-4">
          {results.map(post => (
            <li class="border border-gray-200 rounded-lg p-4 hover:border-pink-300 transition-colors">
              <a href={`/posts/${post.id.replace(/\.md$/, '')}`} class="block">
                <h3 class="font-bold text-lg hover:text-pink-500">{post.data.title}</h3>
                {post.data.description && (
                  <p class="text-gray-600 mt-1 text-sm">{post.data.description}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</Layout>
