---
import Layout from '../layouts/Layout.astro';
import HomeHeader from '../components/HomeHeader.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const title = 'Blog';
const description = 'A personal blog powered by Astro';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
const recentPosts = sortedPosts.slice(0, 3);
---

<Layout title={title} description={description}>
  <article class="max-w-6xl mx-auto px-3">
    <HomeHeader title={title} description={description} />

    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 py-8">
      {recentPosts.map((post) => (
        <div class="col-span-1">
          <Card post={{
            url: `/posts/${post.id.replace(/\.md$/, '')}`,
            frontmatter: post.data
          }} />
        </div>
      ))}
    </section>
  </article>

  <section class="flex space-x-8 justify-center text-xl pt-8 font-bold">
    <a href="/posts">
      See All<span class="squiggle">&rarr;</span>
    </a>
  </section>
</Layout>

<style>
  .squiggle {
    filter: url("#squiggle");
  }
</style>
