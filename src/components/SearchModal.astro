---
---

<div id="search-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/50" onclick="closeSearch()"></div>
  <div class="absolute top-[20%] left-1/2 -translate-x-1/2 w-full max-w-xl bg-white rounded-2xl shadow-2xl overflow-hidden">
    <div class="flex items-center px-4 border-b border-gray-200">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="search-input"
        placeholder="搜索文章..."
        class="w-full px-3 py-4 text-lg outline-none"
        autocomplete="off"
      />
      <kbd class="text-xs text-gray-400 border border-gray-300 rounded px-1.5 py-0.5">ESC</kbd>
    </div>
    <ul id="search-results" class="max-h-80 overflow-y-auto">
      <li class="px-4 py-3 text-gray-500 text-sm">输入关键字搜索...</li>
    </ul>
  </div>
</div>

<script>
  let posts: { id: string; title: string; description: string }[] = [];
  let isLoading = true;

  async function loadSearchIndex() {
    if (!isLoading) return;
    try {
      const res = await fetch('/search-index.json');
      posts = await res.json();
      isLoading = false;
    } catch (e) {
      console.error('Failed to load search index');
    }
  }

  function openSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input') as HTMLInputElement;
    modal?.classList.remove('hidden');
    input?.focus();
    loadSearchIndex();
  }

  function closeSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input') as HTMLInputElement;
    modal?.classList.add('hidden');
    if (input) input.value = '';
    const results = document.getElementById('search-results');
    if (results) results.innerHTML = '<li class="px-4 py-3 text-gray-500 text-sm">输入关键字搜索...</li>';
  }

  function search(query: string) {
    const results = document.getElementById('search-results');
    if (!results) return;

    if (!query.trim()) {
      results.innerHTML = '<li class="px-4 py-3 text-gray-500 text-sm">输入关键字搜索...</li>';
      return;
    }

    const q = query.toLowerCase();
    const matched = posts.filter(post =>
      post.title.toLowerCase().includes(q) ||
      post.description.toLowerCase().includes(q)
    );

    if (matched.length === 0) {
      results.innerHTML = '<li class="px-4 py-3 text-gray-500 text-sm">未找到结果</li>';
      return;
    }

    results.innerHTML = matched.map(post => `
      <li>
        <a href="/posts/${post.id}" onclick="closeSearch()" class="block px-4 py-3 hover:bg-gray-50 transition-colors">
          <div class="font-medium">${post.title}</div>
          ${post.description ? `<div class="text-sm text-gray-500 mt-0.5">${post.description}</div>` : ''}
        </a>
      </li>
    `).join('');
  }

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape') {
      closeSearch();
    }
  });

  document.getElementById('search-input')?.addEventListener('input', (e) => {
    search((e.target as HTMLInputElement).value);
  });

  (window as any).openSearch = openSearch;
  (window as any).closeSearch = closeSearch;
</script>
