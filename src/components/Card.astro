---
export interface Props {
  post: any;
}

const { post } = Astro.props;
const formattedDate = new Date(post.frontmatter.pubDate).toLocaleDateString('en-US', {
  month: '2-digit',
  day: '2-digit',
  year: 'numeric'
});
---

<a
  href={post.url}
  class="transition-all duration-75 ease-in-out h-full block relative top-0 hover:-top-2 shadow-lg hover:shadow-xl bg-white rounded-xl overflow-hidden squiggle"
>
  {post.frontmatter.hero && (
    <img
      src={post.frontmatter.hero}
      alt={post.frontmatter.title}
      width="360"
      height="192"
      class="w-full aspect-[15/7] object-cover"
    />
  )}
  <div class="py-6 px-8">
    <h2 class="font-bold text-2xl leading-tight">
      {post.frontmatter.title}
    </h2>
    <p class="text-xs text-gray-600 mt-4 flex items-center">
      {formattedDate}
    </p>
  </div>
</a>

<style>
  .squiggle {
    filter: url("#squiggle");
  }
</style>
