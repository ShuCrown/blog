---
export interface Props {
  title: string;
  date?: string;
  hero?: string;
  youtube?: string;
}

const { title, date, hero, youtube } = Astro.props;
---

<article class="max-w-5xl mx-auto px-3">
  <header class="mx-auto max-w-3xl text-center py-12 lg:py-16">
    <h1 class="text-4xl lg:text-6xl font-black uppercase mb-4" style="font-family: 'Londrina Solid', sans-serif; line-height: 1;">
      {title}
    </h1>
    {date && <p class="text-sm text-gray-500">{date}</p>}
  </header>

  <!-- Image -->
  {hero && <img class="rounded-xl mx-auto my-8 w-full max-w-3xl" loading="lazy" src={hero} alt={title} />}

  <!-- YouTube Video -->
  {youtube && <div class="aspect-ratio-16/9 mt-6 lg:mt-12">
    <iframe
      width="700"
      height="500"
      class="embed-responsive-item w-full h-full"
      src={`https://www.youtube.com/embed/${youtube}`}
      frameborder="0"
      allow="accelerometer; autoplay; encrypted-media; gyroscope;"
      allowfullscreen
    ></iframe>
  </div>}

  <!-- Content -->
  <section class="max-w-3xl mx-auto py-6 lg:py-12 content">
    <slot />
  </section>
</article>

<style>
  .aspect-ratio-16\/9 {
    position: relative;
    height: 0;
    padding-bottom: 56.25%;
  }
  .aspect-ratio-16\/9 iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
</style>
